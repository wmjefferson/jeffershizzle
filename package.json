{
  "name": "jeffershizzle",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"build\"",
    "buildlog": "node ..\\jeffersonwm\\scripts\\logged-build.mjs --app jeffershizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"buildlog\"",
    "buildlog:jeffershizzle": "node ..\\jeffersonwm\\scripts\\logged-build.mjs --app jeffershizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"buildlog:jeffershizzle\"",
    "buildlog:shizzle": "node ..\\jeffersonwm\\scripts\\logged-build.mjs --app shizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"buildlog:shizzle\"",
    "jeffvers": "node ..\\jeffersonwm\\scripts\\version-log.mjs --app jeffershizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"jeffvers\"",
    "jeffvers:jeffershizzle": "node ..\\jeffersonwm\\scripts\\version-log.mjs --app jeffershizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"jeffvers:jeffershizzle\"",
    "jeffvers:shizzle": "node ..\\jeffersonwm\\scripts\\version-log.mjs --app shizzle && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"jeffvers:shizzle\"",
    "preview": "vite preview",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "npm version patch --no-git-tag-version && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:patch\"",
    "version:minor": "npm version minor --no-git-tag-version && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:minor\"",
    "version:major": "npm version major --no-git-tag-version && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:major\"",
    "version:patch:jeffershizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app jeffershizzle --type patch && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:patch:jeffershizzle\"",
    "version:patch:shizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app shizzle --type patch && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:patch:shizzle\"",
    "version:minor:jeffershizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app jeffershizzle --type minor && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:minor:jeffershizzle\"",
    "version:minor:shizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app shizzle --type minor && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:minor:shizzle\"",
    "version:major:jeffershizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app jeffershizzle --type major && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:major:jeffershizzle\"",
    "version:major:shizzle": "node ..\\jeffersonwm\\scripts\\version-and-log.mjs --app shizzle --type major && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"version:major:shizzle\"",
    "publish": "npm run build && node scripts/publish.mjs && node ..\\jeffersonwm\\scripts\\finish-stamp.mjs --label \"publish\""
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
